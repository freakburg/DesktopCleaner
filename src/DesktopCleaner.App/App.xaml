<Application x:Class="DesktopCleaner.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Replaced at startup and whenever Windows switches between light and dark (see Theme.cs). -->
        <SolidColorBrush x:Key="MutedBrush" Color="#555555"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#EEEEEE"/>
    </Application.Resources>
</Application>
